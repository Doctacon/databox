# Run `npm run dev:public` or `npm run build:public`. Public mode renders the
# full Rufous interface but Vite aliases its local FastAPI clients to browser
# adapters. It has no API key, Turnstile secret, email configuration, or R2
# credential. The Turnstile site key below is public browser configuration.

# Production may set this non-secret, exact immutable R2 prefix. The loader
# validates its release pointer and falls back to the complete same-origin
# `/data` snapshot on any failure.
VITE_RUFOUS_DATA_BASE_URL=https://rufous-data.loughondata.com/rufous-public

# Optional production-only AI field-strategy enhancement. Leave the site key
# empty for local development and pull-request builds; the deterministic planner
# remains fully functional. Never put the Turnstile secret key or a Cloudflare
# API token in a VITE_ variable.
VITE_RUFOUS_AI_URL=https://rufous-ai.loughondata.com
VITE_RUFOUS_TURNSTILE_SITE_KEY=
