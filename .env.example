# Databox Environment Configuration
#
# Application runtime config is declared in databox/config/settings.py. Keep
# placeholders synchronized with their consumers.

# Quack loads all dlt sources into data/databox.duckdb through one local server.

# Quack local server (only needed when overriding defaults)
# DATABOX_QUACK_URI=quack:localhost:9494
# DATABOX_QUACK_TOKEN=databox_quack_token

# Logging / local privacy defaults
LOG_LEVEL=INFO
RUNTIME__DLTHUB_TELEMETRY=false
SQLMESH__DISABLE_ANONYMIZED_ANALYTICS=true

# Per-source ingest window overrides (defaults: 30)
# eBird's recent-observation API accepts 1-30 days.
# DATABOX_EBIRD_DAYS_BACK=30
# GBIF search refreshes accept 1-10,000 records (default: 1,000). Public
# releases use 3,000 and reserve a namesake sample without high offsets.
# DATABOX_GBIF_MAX_RECORDS=1000
# The normal local GBIF asset remains the general Arizona Aves search. Only the
# static release workflow enables the licensed EOD-only publication slice.
# DATABOX_GBIF_PUBLIC_RELEASE=false
# DATABOX_NOAA_DAYS_BACK=30
# DATABOX_USGS_DAYS_BACK=30

# OpenLineage — unset by default. Dagster attaches the OpenLineage sensor
# at startup when OPENLINEAGE_URL is set. Point at Marquez / DataHub /
# OpenMetadata / Atlan / Astro — every major lineage catalog speaks
# OpenLineage. See docs/observability.md. Requires `uv sync --extra lineage`.
# OPENLINEAGE_URL=http://localhost:5000
# OPENLINEAGE_NAMESPACE=databox
# OPENLINEAGE_API_KEY=

# Cloudflare Workers AI (required by the local Birding Trip Copilot agent)
# Only @cf/zai-org/glm-4.7-flash is permitted by the runtime.
# MODEL_BASE_URL accepts this exact identifier (and derives Cloudflare's official
# account endpoint) or an HTTPS api.cloudflare.com Workers AI URL.
CF_WORKERS_AI_API_KEY=
CF_WORKERS_AI_ACCOUNT_ID=
CF_WORKERS_AI_MODEL_BASE_URL=@cf/zai-org/glm-4.7-flash

# Generic local SMTP bird-alert delivery (initial deployment: Proton Mail Bridge).
# Keep every value local. Host must be numeric loopback; CA file must contain
# exactly the exported Bridge public certificate, never its private key.
BIRD_ALERT_SMTP_ENABLED=false
BIRD_ALERT_SMTP_SECURITY=starttls
BIRD_ALERT_SMTP_HOST=
BIRD_ALERT_SMTP_PORT=
BIRD_ALERT_SMTP_USERNAME=
BIRD_ALERT_SMTP_PASSWORD=
BIRD_ALERT_FROM_EMAIL=
BIRD_ALERT_RECIPIENT_EMAIL=
BIRD_ALERT_SMTP_CA_FILE=

# Pipeline API Keys (add keys for each registered pipeline)
EBIRD_API_TOKEN=your_ebird_api_token_here
NOAA_API_TOKEN=your_noaa_api_token_here
XENO_CANTO_API_KEY=your_xeno_canto_api_key_here

# Rufous public static export deliberately excludes direct eBird API/download
# material. Production occurrences come only from the explicitly allowlisted
# GBIF eBird EOD dataset and therefore need no Cornell approval environment flag.

# Local Polaris + AWS S3 Iceberg lake.
DATABOX_POLARIS_POSTGRES_PASSWORD=
DATABOX_POLARIS_CLIENT_ID=
DATABOX_POLARIS_CLIENT_SECRET=
DATABOX_POLARIS_URL=http://127.0.0.1:8181
DATABOX_ICEBERG_CATALOG=databox_lake
DATABOX_AWS_ACCESS_KEY_ID=
DATABOX_AWS_SECRET_ACCESS_KEY=
DATABOX_AWS_REGION=us-west-1
DATABOX_AWS_S3_BUCKET=
DATABOX_AWS_ROLE_ARN=
