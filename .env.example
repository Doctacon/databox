# Databox Environment Configuration
#
# Application runtime config is declared in databox/config/settings.py. Keep
# placeholders synchronized with their consumers.

# Logging / local privacy defaults
LOG_LEVEL=INFO
RUNTIME__DLTHUB_TELEMETRY=false
SQLMESH__DISABLE_ANONYMIZED_ANALYTICS=true

# Per-source ingest window overrides (defaults: 30)
# eBird's recent-observation API accepts 1-30 days.
# DATABOX_EBIRD_DAYS_BACK=30
# GBIF search refreshes accept 1-10,000 records (default: 1,000).
# The explicit data-product release slice uses licensed eBird EOD observations.
# DATABOX_GBIF_MAX_RECORDS=1000
# DATABOX_GBIF_PUBLIC_RELEASE=false
# DATABOX_NOAA_DAYS_BACK=30
# DATABOX_USGS_DAYS_BACK=30

# OpenLineage — unset by default. Dagster attaches the OpenLineage sensor
# at startup when OPENLINEAGE_URL is set. Point at Marquez / DataHub /
# OpenMetadata / Atlan / Astro — every major lineage catalog speaks
# OpenLineage. See docs/observability.md. Requires `uv sync --extra lineage`.
# OPENLINEAGE_URL=http://localhost:5000
# OPENLINEAGE_NAMESPACE=databox
# OPENLINEAGE_API_KEY=

# Pipeline API Keys (add keys for each registered pipeline)
EBIRD_API_TOKEN=your_ebird_api_token_here
NOAA_API_TOKEN=your_noaa_api_token_here
XENO_CANTO_API_KEY=your_xeno_canto_api_key_here

# Local Polaris + AWS S3 Iceberg lake. The catalog must be pre-provisioned with
# the configured warehouse prefix and bucket-scoped IAM role.
DATABOX_POLARIS_POSTGRES_PASSWORD=
DATABOX_POLARIS_CLIENT_ID=
DATABOX_POLARIS_CLIENT_SECRET=
DATABOX_POLARIS_URL=http://127.0.0.1:8181
DATABOX_ICEBERG_CATALOG=databox_lake
DATABOX_ICEBERG_WAREHOUSE_PREFIX=warehouse
DATABOX_AWS_ACCESS_KEY_ID=
DATABOX_AWS_SECRET_ACCESS_KEY=
# Required by compose. Use the token paired with temporary AWS credentials.
DATABOX_AWS_SESSION_TOKEN=
DATABOX_AWS_REGION=us-west-1
DATABOX_AWS_S3_BUCKET=
DATABOX_AWS_ROLE_ARN=
# Recovery automation: output names from infra/recovery after reviewed apply.
DATABOX_CATALOG_BACKUP_BUCKET=
# Short-lived credentials for the dedicated catalog-backup role. Obtain these
# on the host before starting Compose; never commit them.
DATABOX_BACKUP_AWS_ACCESS_KEY_ID=
DATABOX_BACKUP_AWS_SECRET_ACCESS_KEY=
DATABOX_BACKUP_AWS_SESSION_TOKEN=
# Generate outside the repository; required at each real pgBackRest boundary.
PGBACKREST_REPO1_CIPHER_PASS=
